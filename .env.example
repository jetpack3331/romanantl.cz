# Zkopíruj do .env a vyplň. Soubor .env se do repozitáře necommituje.
# V Dockeru (docker compose up) se načte automaticky z .env v kořeni projektu.

# Gmail odesílatel (kontaktní formulář)
SENDER_EMAIL=romcaantl@gmail.com
SENDER_PASSWORD=
CONTACT_EMAIL=romcaantl@gmail.com

# Cloudflare Turnstile (invisible CAPTCHA). Both must be set for verification to run.
# Astro only reads PUBLIC_* (not NEXT_PUBLIC_*). Restart dev server after changing .env.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PUBLIC_SITE_URL=https://romanantl.cz

# CRM (/crm): password login + outreach e-mails over SMTP
# CRM_SECRET: random string, at least 32 chars (openssl rand -base64 48). It signs the login
# cookie and the unsubscribe links in sent e-mails - changing it breaks already sent links.
CRM_PASSWORD=
CRM_SECRET=
CRM_SMTP_HOST=
CRM_SMTP_PORT=465
CRM_SMTP_USER=
CRM_SMTP_PASSWORD=
# Sender address (defaults to CRM_SMTP_USER); must be allowed by the SMTP account
CRM_SMTP_FROM=
# Directory of the CRM SQLite database crm.db (default ./data, /app/data in Docker)
CRM_DATA_DIR=
