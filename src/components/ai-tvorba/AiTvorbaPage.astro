---
import type { Messages } from "@/lib/get-messages";
import { placeholdUrl } from "@/lib/placehold";

interface Props {
  messages: Messages;
}

const { messages: t } = Astro.props;

const items = t.tvorba.items as Array<{
  id: string;
  title: string;
  description: string;
  imageText: string;
  hasVariants?: boolean;
  variantsText?: string;
}>;

const aiHero = t.hero.aiHero as {
  title: string;
  description: string;
  subtitle: string;
};
const aiAvatars = t.hero.aiAvatars as { title: string; description: string };
---

<div class="min-h-screen bg-pastel-cream">
  <main class="mx-auto max-w-5xl px-6 py-10 md:py-14">
    <section class="grid gap-10 md:grid-cols-2 md:items-start md:gap-12">
      <div>
        <h1 class="font-display text-2xl font-bold text-pastel-dark md:text-3xl">
          {aiHero.title}
        </h1>
        <p class="mt-3 text-sm text-pastel-dark/90 leading-relaxed">
          {aiHero.description}
        </p>
        <p class="mt-3 text-sm text-pastel-dark/85 leading-relaxed">
          {aiHero.subtitle}
        </p>
      </div>
      <div class="card p-5">
        <h2 class="font-display text-lg font-bold text-pastel-dark">
          {aiAvatars.title}
        </h2>
        <p class="mt-2 text-sm text-pastel-dark/85">
          {aiAvatars.description}
        </p>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="font-display text-2xl font-bold text-pastel-dark">
        {t.tvorba.title}
      </h2>
      <p class="mt-2 text-pastel-dark/80 max-w-2xl">
        {t.tvorba.subtitle}
      </p>
      <ul class="mt-8 space-y-10">
        {
          items.map((item) => (
            <li>
              <article class="card overflow-hidden p-0">
                {item.id === "dress" ? (
                  <div class="grid grid-cols-1 gap-4 p-5 md:grid-cols-3 md:gap-6">
                    <div class="space-y-4 md:col-span-1">
                      <p class="text-sm font-semibold text-pastel-accent">
                        {t.tvorba.originalLabel}
                      </p>
                      <div class="relative aspect-[3/4] w-full overflow-hidden rounded-lg">
                        <img
                          src="/portfolio/dress/original.jpg"
                          alt={`${item.imageText} — source 1`}
                          width={300}
                          height={400}
                          class="h-full w-full object-cover"
                        />
                      </div>
                      <div class="relative aspect-[3/4] w-full overflow-hidden rounded-lg">
                        <img
                          src="/portfolio/dress/original_2.jpg"
                          alt={`${item.imageText} — source 2`}
                          width={300}
                          height={400}
                          class="h-full w-full object-cover"
                        />
                      </div>
                    </div>
                    <div class="md:col-span-2">
                      <p class="text-sm font-semibold text-pastel-accent mb-2">
                        {t.tvorba.productPhotosLabel}
                      </p>
                      <div class="grid grid-cols-2 gap-2">
                        {(["1.png", "2.png", "3.jpeg", "4.png"] as const).map(
                          (file) => (
                            <div class="relative aspect-[3/4] overflow-hidden rounded-lg">
                              <img
                                src={`/portfolio/dress/${file}`}
                                alt={`${item.imageText} ${file}`}
                                width={300}
                                height={400}
                                class="h-full w-full object-cover"
                              />
                            </div>
                          )
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div
                    class:list={[
                      "grid gap-4 p-5",
                      item.hasVariants
                        ? "md:grid-cols-5 md:gap-6"
                        : "md:grid-cols-2",
                    ]}
                  >
                    <div class="w-full md:col-span-2">
                      {(item.id === "1" || item.id === "parfem") && (
                        <p class="text-sm font-semibold text-pastel-accent mb-2">
                          {t.tvorba.originalLabel}
                        </p>
                      )}
                      <div class="relative aspect-square w-full">
                        {item.id === "1" ? (
                          <img
                            src="/portfolio/desk-timer/original.jpg"
                            alt={item.imageText}
                            width={400}
                            height={400}
                            class="h-full w-full rounded-lg object-cover"
                          />
                        ) : item.id === "parfem" ? (
                          <img
                            src="/portfolio/parfem/optimized/original.jpg"
                            alt={item.imageText}
                            width={400}
                            height={400}
                            class="h-full w-full rounded-lg object-cover"
                          />
                        ) : (
                          <img
                            src={placeholdUrl(400, 400, item.imageText)}
                            alt=""
                            width={400}
                            height={400}
                            class="h-full w-full rounded-lg object-cover"
                          />
                        )}
                      </div>
                    </div>
                    {item.hasVariants ? (
                      <div class="md:col-span-3">
                        {(item.id === "1" || item.id === "parfem") && (
                          <p class="text-sm font-semibold text-pastel-accent mb-2">
                            {t.tvorba.productPhotosLabel}
                          </p>
                        )}
                        <div class="grid grid-cols-4 gap-2 md:grid-cols-2">
                          {[1, 2, 3, 4].map((i) => (
                            <div class="relative aspect-square">
                              {item.id === "1" ? (
                                <img
                                  src={`/portfolio/desk-timer/${i}.png`}
                                  alt={`${item.imageText} ${i}`}
                                  width={200}
                                  height={200}
                                  class="h-full w-full rounded-lg object-cover"
                                />
                              ) : item.id === "parfem" ? (
                                <img
                                  src={`/portfolio/parfem/optimized/${i}.jpg`}
                                  alt={`${item.imageText} ${i}`}
                                  width={200}
                                  height={200}
                                  class="h-full w-full rounded-lg object-cover"
                                />
                              ) : (
                                <img
                                  src={placeholdUrl(
                                    200,
                                    200,
                                    `${item.imageText} ${i}`
                                  )}
                                  alt=""
                                  width={200}
                                  height={200}
                                  class="h-full w-full rounded-lg object-cover"
                                />
                              )}
                            </div>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <div class="flex flex-col justify-center">
                        <h3 class="font-display font-bold text-pastel-dark">
                          {item.title}
                        </h3>
                        <p class="mt-2 text-sm text-pastel-dark/80">
                          {item.description}
                        </p>
                      </div>
                    )}
                  </div>
                )}
                {item.hasVariants && (
                  <div class="border-t border-pastel-sage/60 px-5 py-4">
                    <h3 class="font-display font-bold text-pastel-dark">
                      {item.title}
                    </h3>
                    <p class="mt-1 text-sm text-pastel-dark/80">
                      {item.description}
                    </p>
                    {item.variantsText && (
                      <p class="mt-2 text-xs text-pastel-accent">
                        {item.variantsText}
                      </p>
                    )}
                  </div>
                )}
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="pricing" class="mt-16 scroll-mt-8">
      <h2 class="font-display text-2xl font-bold text-pastel-dark">
        {t.pricing.title}
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          t.pricing.packages.map((pkg, idx) => {
            const styles =
              [
                {
                  bg: "bg-pricing-starter",
                  text: "text-pastel-dark",
                  accent: "text-pastel-dark/80",
                },
                {
                  bg: "bg-pricing-standard",
                  text: "text-pastel-dark",
                  accent: "text-pastel-dark/80",
                },
                {
                  bg: "bg-pricing-premium",
                  text: "text-pastel-dark",
                  accent: "text-pastel-dark/80",
                },
              ][idx] ?? {
                bg: "bg-pricing-starter",
                text: "text-pastel-dark",
                accent: "text-pastel-dark/80",
              };
            return (
              <div
                class:list={[
                  "card p-5 flex flex-col border-0 shadow-soft",
                  styles.bg,
                ]}
              >
                <h3 class:list={["font-display text-lg font-bold", styles.text]}>
                  {pkg.name}
                </h3>
                <p class:list={["mt-2 text-xl font-bold", styles.accent]}>
                  {pkg.price}
                </p>
                <ul
                  class:list={[
                    "mt-4 flex-1 space-y-2 text-sm opacity-90",
                    styles.text,
                  ]}
                >
                  {pkg.features.map((f, i) => (
                    <li class="flex gap-2">
                      <span class:list={["shrink-0", styles.accent]}>·</span>
                      <span class:list={i === 0 ? "font-semibold" : ""}>
                        {f}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
      <div class="mt-10 card p-6 bg-pricing-retainer border-0 shadow-soft text-pastel-cream">
        <h3 class="font-display text-lg font-bold">
          {t.pricing.retainer.name}
        </h3>
        <p class="mt-2 text-xl font-bold text-pastel-cream/95">
          {t.pricing.retainer.price}
        </p>
        <ul class="mt-4 space-y-2 text-sm text-pastel-cream/90">
          {
            t.pricing.retainer.features.map((f, i) => (
              <li class="flex gap-2">
                <span class="text-pastel-cream/80 shrink-0">·</span>
                <span class:list={i === 0 ? "font-semibold" : ""}>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</div>
