---
import type { Locale } from "@/lib/i18n";
import { buildLocaleHref } from "@/lib/locale-links";
import { routePath } from "@/lib/routes";
import type { Messages } from "@/lib/get-messages";

interface Props {
  locale: Locale;
  messages: Messages;
  pathname: string;
}

const { locale, messages, pathname } = Astro.props;
const nav = messages.nav;
---

<header
  class="sticky top-0 z-10 border-b border-pastel-sand/80 bg-pastel-cream/95 backdrop-blur"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <nav class="flex flex-wrap items-center gap-5">
      <a
        href={locale === "cs" ? "/" : `/${locale}`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.home}
      </a>
      <a
        href={locale === "cs" ? "/#portfolio" : `/${locale}#portfolio`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.portfolio}
      </a>
      <a
        href={routePath("product", locale)}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.tvorba}
      </a>
      <a
        href={locale === "cs" ? "/#about" : `/${locale}#about`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.about}
      </a>
      <a
        href={routePath("experience", locale)}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.employers}
      </a>
      <a
        href={locale === "cs" ? "/#contact" : `/${locale}#contact`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent"
      >
        {nav.contact}
      </a>
    </nav>
    <div class="flex items-center gap-1" role="group" aria-label="Jazyk / Language / Idioma">
      <a
        href={buildLocaleHref(pathname, "cs")}
        hreflang="cs"
        aria-label="Čeština"
        aria-current={locale === "cs" ? "true" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-btn text-lg transition hover:bg-pastel-sand",
          locale === "cs" &&
            "bg-pastel-sand/80 ring-1 ring-pastel-accent/50",
        ]}
        title="Čeština"
      >
        CZ
      </a>
      <a
        href={buildLocaleHref(pathname, "en")}
        hreflang="en"
        aria-label="English"
        aria-current={locale === "en" ? "true" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-btn text-lg transition hover:bg-pastel-sand",
          locale === "en" &&
            "bg-pastel-sand/80 ring-1 ring-pastel-accent/50",
        ]}
        title="English"
      >
        EN
      </a>
      <a
        href={buildLocaleHref(pathname, "es")}
        hreflang="es"
        aria-label="Español"
        aria-current={locale === "es" ? "true" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-btn text-lg transition hover:bg-pastel-sand",
          locale === "es" &&
            "bg-pastel-sand/80 ring-1 ring-pastel-accent/50",
        ]}
        title="Español"
      >
        ES
      </a>
    </div>
  </div>
</header>
