---
import type { Locale } from "@/lib/i18n";
import { buildLocaleHref } from "@/lib/locale-links";
import type { Messages } from "@/lib/get-messages";

interface Props {
  locale: Locale;
  messages: Messages;
  pathname: string;
}

const { locale, messages, pathname } = Astro.props;
const nav = messages.nav;
---

<header
  class="sticky top-0 z-10 border-b border-pastel-sand/80 bg-pastel-cream/95 backdrop-blur dark:border-pastel-dark-secondary dark:bg-pastel-dark/95"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <nav class="flex flex-wrap items-center gap-5">
      <a
        href={locale === "cs" ? "/" : `/${locale}`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.home}
      </a>
      <a
        href={locale === "cs" ? "/ai-tvorba" : `/${locale}/ai-tvorba`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.tvorba}
      </a>
      <a
        href={locale === "cs" ? "/ai-tvorba#pricing" : `/${locale}/ai-tvorba#pricing`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.pricing}
      </a>
      <a
        href={locale === "cs" ? "/#about" : `/${locale}#about`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.about}
      </a>
      <a
        href={locale === "cs" ? "/#employers" : `/${locale}#employers`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.employers}
      </a>
      <a
        href={locale === "cs" ? "/#contact" : `/${locale}#contact`}
        class="font-display text-sm font-medium text-pastel-dark hover:text-pastel-accent dark:text-pastel-cream dark:hover:text-pastel-dark-accent"
      >
        {nav.contact}
      </a>
    </nav>
    <div class="flex items-center gap-1" role="group" aria-label="Jazyk / Language">
      <a
        href={buildLocaleHref(pathname, "cs")}
        hreflang="cs"
        aria-label="Čeština"
        aria-current={locale === "cs" ? "true" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-btn text-lg transition hover:bg-pastel-sand dark:hover:bg-pastel-dark-secondary",
          locale === "cs" &&
            "bg-pastel-sand/80 dark:bg-pastel-dark-secondary/80 ring-1 ring-pastel-accent/50",
        ]}
        title="Čeština"
      >
        CZ
      </a>
      <a
        href={buildLocaleHref(pathname, "en")}
        hreflang="en"
        aria-label="English"
        aria-current={locale === "en" ? "true" : undefined}
        class:list={[
          "flex h-9 w-9 items-center justify-center rounded-btn text-lg transition hover:bg-pastel-sand dark:hover:bg-pastel-dark-secondary",
          locale === "en" &&
            "bg-pastel-sand/80 dark:bg-pastel-dark-secondary/80 ring-1 ring-pastel-accent/50",
        ]}
        title="English"
      >
        EN
      </a>
    </div>
  </div>
</header>
