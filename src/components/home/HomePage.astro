---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Locale } from "@/lib/i18n";
import type { Messages } from "@/lib/get-messages";
import { socialLinks, portfolioProjects } from "@/lib/content";
import { placeholdUrl } from "@/lib/placehold";
import { routePath } from "@/lib/routes";
import { ContactForm } from "@/components/react/ContactForm.tsx";
import BioWithBold from "@/components/home/BioWithBold.astro";

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages: t } = Astro.props;

const sections = t.hero.left.sections as Array<{
  title: string;
  description: string;
  showProductLink?: boolean;
}>;
const heroRight = t.hero.right as {
  name: string;
  subtitle: string;
  bio: string;
  cta: string;
  techStack: string[];
};

const skillsList = t.about.skillsList as string[];
const aiSkillsList = t.about.aiSkillsList as string[];

const experienceHref = routePath("experience", locale);
const productHref = routePath("product", locale);

type PortfolioItem = { id: string; title: string; description: string };
const portfolioItems = t.portfolio.items as PortfolioItem[];

// Screenshots that have been uploaded to src/assets/portfolio/<id>.<ext>.
// Anything without a matching file here falls back to a placeholder below,
// so a project can be added to `portfolioProjects` before its screenshot exists.
const portfolioImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/portfolio/*",
  { eager: true }
);
function findPortfolioImage(id: string): ImageMetadata | undefined {
  const entry = Object.entries(portfolioImages).find(([path]) =>
    path.includes(`/${id}.`)
  );
  return entry?.[1].default;
}

const portfolioCards = portfolioProjects.map((project) => {
  const item = portfolioItems.find((i) => i.id === project.id);
  return {
    id: project.id,
    href: project.href,
    title: item?.title ?? project.id,
    description: item?.description ?? "",
    image: findPortfolioImage(project.id),
  };
});
---

<div class="min-h-screen bg-pastel-cream">
  <main class="mx-auto max-w-5xl px-6 py-10 md:py-14">
    <section class="grid gap-10 md:grid-cols-2 md:items-start md:gap-12">
      <div class="space-y-6">
        {
          sections.map((section) => (
            <div>
              <h2 class="font-display text-lg font-bold text-pastel-dark md:text-xl">
                {section.title}
              </h2>
              <p class="mt-2 text-sm text-pastel-dark/90 leading-relaxed">
                {section.description}
                {section.showProductLink && (
                  <>
                    {" "}
                    <a
                      href={productHref}
                      class="font-semibold text-pastel-accent underline-offset-4 hover:underline"
                    >
                      {t.hero.left.productLinkLabel}
                    </a>
                    .
                  </>
                )}
              </p>
            </div>
          ))
        }
      </div>
      <div class="rounded-card overflow-hidden bg-pastel-sand/60 p-6 shadow-soft flex flex-col items-center text-center">
        <img
          alt={t.site.name}
          class="rounded-2xl w-48 h-48 md:w-56 md:h-56 object-cover object-top shadow-soft"
          src="/profile_picture.jpeg"
          width={224}
          height={224}
          fetchpriority="high"
        />
        <h2 class="font-display mt-5 text-xl font-bold text-pastel-dark md:text-2xl">
          {heroRight.name}
        </h2>
        <p class="mt-1 text-xs font-medium text-pastel-accent uppercase tracking-wide">
          {heroRight.subtitle}
        </p>
        <div class="mt-4 text-left w-full">
          <BioWithBold text={heroRight.bio} />
        </div>
        <a href="#contact" class="btn-primary mt-6 inline-block">
          {heroRight.cta}
        </a>
        <div
          class="mt-6 flex flex-wrap justify-center gap-2"
          aria-label="Technologie"
        >
          {
            heroRight.techStack.map((tech) => (
              <span
                class="rounded-full bg-pastel-sage/60 px-3 py-1 text-xs font-medium text-pastel-dark/90"
              >
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <section id="portfolio" class="mt-16 scroll-mt-8">
      <h2 class="font-display text-2xl font-bold text-pastel-dark">
        {t.portfolio.title}
      </h2>
      <p class="mt-2 max-w-2xl text-pastel-dark/80">
        {t.portfolio.subtitle}
      </p>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          portfolioCards.map((project) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card group block overflow-hidden p-0"
            >
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-pastel-sand/40">
                {project.image ? (
                  <Image
                    src={project.image}
                    alt={project.title}
                    width={800}
                    height={600}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <img
                    src={placeholdUrl(600, 450, project.title)}
                    alt={project.title}
                    width={600}
                    height={450}
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                )}
              </div>
              <div class="p-5">
                <h3 class="font-display font-bold text-pastel-dark">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm text-pastel-dark/75">
                  {project.description}
                </p>
                <span class="mt-3 inline-block text-sm font-semibold text-pastel-accent group-hover:underline">
                  {t.portfolio.viewSiteLabel} →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="about" class="mt-16 scroll-mt-8">
      <h2 class="font-display text-2xl font-bold text-pastel-dark">
        {t.about.title}
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        <a href={experienceHref} class="card group p-5 transition hover:bg-pastel-sand/40">
          <h3 class="font-display font-bold text-pastel-dark">
            {t.about.experienceCta.title}
          </h3>
          <p class="mt-2 text-sm text-pastel-dark/80">
            {t.about.experienceCta.description}
          </p>
          <span class="mt-3 inline-block text-sm font-semibold text-pastel-accent group-hover:underline">
            {t.about.experienceCta.linkLabel} →
          </span>
        </a>
        <div class="card p-5">
          <h3 class="font-display font-bold text-pastel-dark">
            {t.about.skills}
          </h3>
          <p class="mt-2 text-sm text-pastel-dark/80">
            {skillsList.join(", ")}
          </p>
        </div>
        <div class="card p-5">
          <h3 class="font-display font-bold text-pastel-dark">
            {t.about.aiTitle}
          </h3>
          <p class="mt-2 text-sm text-pastel-dark/80">
            {aiSkillsList.join(", ")}
          </p>
        </div>
      </div>
    </section>

    <section id="contact" class="mt-16 scroll-mt-8">
      <h2 class="font-display text-2xl font-bold text-pastel-dark">
        {t.contact.title}
      </h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div class="card p-6">
          <h3 class="font-display font-bold text-pastel-dark">
            {t.contact.formTitle}
          </h3>
          <div class="mt-4">
            <ContactForm client:load messages={t.contact} />
          </div>
        </div>
        <div class="card p-6">
          <h3 class="font-display font-bold text-pastel-dark">
            {t.contact.otherContacts}
          </h3>
          <div class="mt-4 flex flex-wrap gap-3">
            {
              socialLinks.map(({ href, label, icon, color }) => (
                <a
                  href={href}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="socialbtn text-white"
                  style={{ backgroundColor: color }}
                  aria-label={label}
                >
                  <i class={icon} />
                </a>
              ))
            }
          </div>
          <p class="mt-4 text-sm text-pastel-dark/80">
            {t.contact.otherContactsDesc}
          </p>
        </div>
      </div>
    </section>

    <footer class="mt-16 border-t border-pastel-sage/50 py-6 text-center text-sm text-pastel-dark/70">
      {t.footer.credit}
    </footer>
  </main>
</div>
