---
import CrmLayout from "@/layouts/CrmLayout.astro";
import { getDb } from "@/lib/crm/db";
import { formatCrmDate } from "@/lib/crm/format";
import {
  countSentEmails,
  listSentEmails,
  listUnsubscribes,
} from "@/lib/crm/outreach/repository";

export const prerender = false;

const db = getDb();
const sent = listSentEmails(db);
const total = countSentEmails(db);
const unsubscribed = listUnsubscribes(db);
const unsubscribedEmails = new Set(unsubscribed.map((record) => record.email));
---

<CrmLayout title="Odeslané e-maily" nav>
  <main class="mx-auto max-w-7xl px-6 py-8">
    <h1 class="font-display text-2xl font-bold">Odeslané e-maily ({total})</h1>
    {
      sent.length === 0 ? (
        <p class="mt-2 text-sm text-pastel-dark/60">Zatím nic.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-pastel-dark/60">
              <tr>
                <th class="py-2 pr-4 font-medium">Datum</th>
                <th class="py-2 pr-4 font-medium">Firma</th>
                <th class="py-2 pr-4 font-medium">E-mail</th>
                <th class="py-2 pr-4 font-medium">Web</th>
                <th class="py-2 pr-4 font-medium">Odesílatel</th>
              </tr>
            </thead>
            <tbody>
              {sent.map((record) => (
                <tr class="border-t border-pastel-sand">
                  <td class="whitespace-nowrap py-2 pr-4">{formatCrmDate(record.sentAt)}</td>
                  <td class="py-2 pr-4">
                    {record.clientId ? (
                      <a href={`/crm/klienti/${record.clientId}`} class="underline">
                        {record.companyName}
                      </a>
                    ) : (
                      record.companyName
                    )}
                  </td>
                  <td class="py-2 pr-4">
                    {record.toEmail}
                    {unsubscribedEmails.has(record.toEmail) && (
                      <span class="ml-2 rounded-btn bg-red-100 px-2 py-0.5 text-xs text-red-700">
                        odhlášen
                      </span>
                    )}
                  </td>
                  <td class="py-2 pr-4">{record.clientUrl}</td>
                  <td class="py-2 pr-4">{record.senderName}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    <section class="mt-10">
      <h2 class="font-display text-lg font-bold">Odhlášené kontakty ({unsubscribed.length})</h2>
      {
        unsubscribed.length === 0 ? (
          <p class="mt-2 text-sm text-pastel-dark/60">Nikdo se zatím neodhlásil.</p>
        ) : (
          <ul class="mt-3 text-sm">
            {unsubscribed.map((record) => (
              <li>
                {record.email}
                <span class="text-pastel-dark/60"> - {formatCrmDate(record.unsubscribedAt)}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</CrmLayout>
