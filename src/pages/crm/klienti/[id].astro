---
import CrmLayout from "@/layouts/CrmLayout.astro";
import ClientForm from "@/components/crm/ClientForm.astro";
import { getClient, splitEmails } from "@/lib/crm/clients/repository";
import { statusBadgeClass } from "@/lib/crm/clients/statuses";
import { getDb } from "@/lib/crm/db";
import { formatCrmDate, safeHref } from "@/lib/crm/format";
import { listSentEmailsForClient } from "@/lib/crm/outreach/repository";

export const prerender = false;

const id = Number(Astro.params.id);
const db = getDb();
const client = Number.isInteger(id) ? getClient(db, id) : null;
if (!client) {
  return new Response("Klient nenalezen", { status: 404 });
}
const emails = splitEmails(client.emails);
const sentEmails = listSentEmailsForClient(db, client.id);
const justSaved = Astro.url.searchParams.has("ulozeno");

const details: [string, string][] = [
  ["Poslední kontakt", formatCrmDate(client.lastContactAt)],
  ["Zdroj", client.source],
  ["Vytvořeno", formatCrmDate(client.createdAt)],
  ["Naposledy upraveno", formatCrmDate(client.updatedAt)],
];
---

<CrmLayout title={client.name} nav>
  <main class="mx-auto max-w-7xl px-6 py-8">
    <a href="/crm/klienti" class="text-sm underline">← Klienti</a>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <h1 class="font-display text-2xl font-bold">{client.name}</h1>
      <span class={`rounded-btn px-2 py-0.5 text-xs ${statusBadgeClass(client.status)}`}>{client.status}</span>
      {
        emails.length > 0 && client.status !== "nevolat" && (
          <a href={`/crm/email?klient=${client.id}`} class="btn-primary ml-auto">
            Napsat e-mail
          </a>
        )
      }
    </div>
    <p class="mt-1 flex flex-wrap gap-x-4 text-sm">
      {client.website && <a href={safeHref(client.website)} target="_blank" rel="noopener noreferrer" class="underline">{client.website}</a>}
      {client.phone && <a href={`tel:${client.phone.replace(/\s/g, "")}`}>{client.phone}</a>}
      {client.googleMapsUrl && <a href={safeHref(client.googleMapsUrl)} target="_blank" rel="noopener noreferrer" class="underline">Google Maps</a>}
    </p>
    {justSaved && <p class="mt-3 rounded-btn bg-green-100 p-3 text-sm text-green-800" role="status">Uloženo.</p>}

    <div class="mt-6 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <ClientForm client={client} />
      </div>

      <div class="flex flex-col gap-6">
        <section class="card p-5">
          <h2 class="font-display text-lg font-bold">Přehled</h2>
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            {
              details
                .filter(([, value]) => value)
                .map(([label, value]) => (
                  <>
                    <dt class="text-pastel-dark/60">{label}</dt>
                    <dd>{value}</dd>
                  </>
                ))
            }
          </dl>
        </section>

        <section class="card p-5">
          <h2 class="font-display text-lg font-bold">Odeslané e-maily ({sentEmails.length})</h2>
          {
            sentEmails.length === 0 ? (
              <p class="mt-2 text-sm text-pastel-dark/60">Zatím žádný.</p>
            ) : (
              <ul class="mt-3 flex flex-col gap-2 text-sm">
                {sentEmails.map((email) => (
                  <li>
                    {formatCrmDate(email.sentAt)} - {email.toEmail}
                    <span class="text-pastel-dark/60"> ({email.senderName})</span>
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section class="card p-5">
          <h2 class="font-display text-lg font-bold">Smazat klienta</h2>
          <p class="mt-2 text-sm text-pastel-dark/70">
            Klient zmizí ze seznamu. Odeslané e-maily zůstanou v přehledu. Při dalším importu z tabulky
            by se znovu vytvořil.
          </p>
          <button
            id="client-delete"
            type="button"
            data-id={client.id}
            data-name={client.name}
            class="mt-3 rounded-btn border border-red-300 px-3 py-2 text-sm text-red-700 hover:bg-red-50"
          >
            Smazat klienta
          </button>
          <p id="client-delete-result" class="mt-2 text-sm text-red-600" role="status"></p>
        </section>
      </div>
    </div>
  </main>
</CrmLayout>

<script>
  const button = document.getElementById("client-delete") as HTMLButtonElement;
  const result = document.getElementById("client-delete-result") as HTMLElement;

  button.addEventListener("click", async () => {
    if (!window.confirm(`Opravdu smazat klienta „${button.dataset.name}“?`)) return;
    button.disabled = true;
    const res = await fetch(`/api/crm/clients/${button.dataset.id}`, {
      method: "DELETE",
      headers: { "Content-Type": "application/json" },
      body: "{}",
    }).catch(() => null);
    if (res?.ok) {
      window.location.href = "/crm/klienti";
      return;
    }
    button.disabled = false;
    result.textContent = "Smazání selhalo";
  });
</script>
