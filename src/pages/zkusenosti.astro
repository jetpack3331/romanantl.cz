---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import ExperiencePage from "@/components/experience/ExperiencePage.astro";
import { getMessages } from "@/lib/get-messages";
import { routeAlternateLanguages, routePath } from "@/lib/routes";
import { getSiteBaseUrl } from "@/lib/site-url";

const locale = "cs";
const t = getMessages(locale);
const base = getSiteBaseUrl();
const pathname = routePath("experience", locale);
const canonical = `${base}${pathname}`;
const ogImageUrl = `${base}/profile_picture.jpeg`;
const alternateLanguages = routeAlternateLanguages("experience", base);
---

<BaseLayout
  lang="cs"
  title={t.experienceMeta.title}
  description={t.experienceMeta.description}
  canonicalUrl={canonical}
  ogLocale="cs_CZ"
  ogImageUrl={ogImageUrl}
  openGraphUrl={canonical}
  siteName={t.site.name}
  alternateLanguages={alternateLanguages}
>
  <Header locale={locale} messages={t} pathname={pathname} />
  <ExperiencePage messages={t} />
</BaseLayout>
